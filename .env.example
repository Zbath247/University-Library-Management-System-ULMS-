# ==========================================
# University Library Management System (ULMS)
# Digital University of Cambodia
# Environment Configuration Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# For local Docker: postgresql://postgres:postgrespassword@localhost:5432/ulms_db?schema=public
# For Supabase/Neon: postgresql://[user]:[password]@[host]:5432/[db]?sslmode=require
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ulms_db?schema=public"

# Session & Security
SESSION_SECRET="change-this-to-a-secure-random-secret-at-least-32-chars-long"
SESSION_MAX_AGE_MS=86400000

# AI Provider Configuration (Optional - falls back to regex parser if omitted)
# Get a Google Gemini API Key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Google Books API Key (Optional - works with public quota if blank)
GOOGLE_BOOKS_API_KEY=""

# Upload and Storage Limits
UPLOAD_MAX_FILE_SIZE_MB=10
SCAN_STORAGE_PATH="./storage/scans"

